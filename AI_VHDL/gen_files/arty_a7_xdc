# ------------------------------------------------------------------------------
# arty_a7.xdc — HDLC controller top (hdlc_top) on Digilent Arty A7-35T / A7-100T
#
# Replaces the legacy board-specific clkdiv.ucf noted in ARCHITECTURE.md §6.5.
# Pin sites taken from the Digilent Arty A7 master XDC; cross-check against
# the master file for your board revision before first use.
# ------------------------------------------------------------------------------

# ---- 100 MHz system clock ----------------------------------------------------
set_property -dict {PACKAGE_PIN E3 IOSTANDARD LVCMOS33} [get_ports clk]
create_clock -period 10.000 -name sys_clk [get_ports clk]

# ---- Push buttons: btn[0]=send  btn[1]=abort  btn[2]=unused  btn[3]=reset ----
set_property -dict {PACKAGE_PIN D9 IOSTANDARD LVCMOS33} [get_ports {btn[0]}]
set_property -dict {PACKAGE_PIN C9 IOSTANDARD LVCMOS33} [get_ports {btn[1]}]
set_property -dict {PACKAGE_PIN B9 IOSTANDARD LVCMOS33} [get_ports {btn[2]}]
set_property -dict {PACKAGE_PIN B8 IOSTANDARD LVCMOS33} [get_ports {btn[3]}]

# ---- Green LEDs LD4..LD7: OK / CRC_err / Abort / TX busy ----------------------
set_property -dict {PACKAGE_PIN H5  IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN J5  IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN T9  IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33} [get_ports {led[3]}]

# ---- PMOD JA: serial line (JA1 = TxD out, JA2 = RxD in) -----------------------
# For an external loopback self-test (INTERNAL_LOOPBACK = false), jumper
# JA pin 1 to JA pin 2.
set_property -dict {PACKAGE_PIN G13 IOSTANDARD LVCMOS33} [get_ports ja_txd]
set_property -dict {PACKAGE_PIN B11 IOSTANDARD LVCMOS33 PULLUP true} [get_ports ja_rxd]

# ---- Timing exceptions ---------------------------------------------------------
# Buttons and the external serial pins are asynchronous; both are 2FF
# resynchronized inside hdlc_top before use.
set_false_path -from [get_ports {btn[*]}]
set_false_path -from [get_ports ja_rxd]
set_false_path -to   [get_ports {led[*]}]
set_false_path -to   [get_ports ja_txd]

# ---- Configuration -------------------------------------------------------------
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
